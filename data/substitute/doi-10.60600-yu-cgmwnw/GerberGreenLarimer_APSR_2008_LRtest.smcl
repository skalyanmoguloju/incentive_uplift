. 
. * set the number of replications to be the same as the number of loops
. set matsize 10000
{txt}
{com}. cap matrix drop chi2s
{txt}
{com}. matrix chi2s=J(1000, 1, .)
{txt}
{com}. 
. 
. local j = 0
{txt}
{com}. local i = 1
{txt}
{com}. while `i' < 1001 {c -(}
{txt}  2{com}.         set seed 123`j'
{txt}  3{com}.         preserve
{txt}  4{com}.         qui sample 1,count by(hh_id)
{txt}  5{com}.         qui replace hh_size=6 if hh_size > 6
{txt}  6{com}. 
.         * base model (clustering is irrelevant when one person is sampled per household)
.         qui logistic voted treat1 treat2 treat3 treat4 numvotes i.hh_size
{txt}  7{com}.         local n1 = e(N)
{txt}  8{com}.         estimates store BASE_MODEL
{txt}  9{com}.         
.         * alternative model with interactions, using 24 more degrees of freedom
.         qui xi: logistic voted treat1##c.numvotes treat2##c.numvotes treat3##c.numvotes         treat4##c.numvotes treat1##i.hh_size treat2##i.hh_size treat3##i.hh_size        treat4##i.hh_size
{txt} 10{com}.         local n2 = e(N)
{txt} 11{com}.         estimates store ALTERNATIVE_MODEL
{txt} 12{com}. 
.         if `n1' == `n2'{c -(}
{txt} 13{com}.                 * di "Results from draw number `i'"
.                 qui lrtest ALTERNATIVE_MODEL BASE_MODEL
{txt} 14{com}.                 matrix chi2s[`i',1] = r(chi2) 
{txt} 15{com}.                 local i = `i' +1
{txt} 16{com}.         {c )-}
{txt} 17{com}.         
.         restore 
{txt} 18{com}.         local j = `j' +1        
{txt} 19{com}. {c )-}
{txt}
{com}. 
. *** reports the p-value for the average chi2
. preserve
{txt}
{com}. clear
{txt}
{com}. svmat chi2s
