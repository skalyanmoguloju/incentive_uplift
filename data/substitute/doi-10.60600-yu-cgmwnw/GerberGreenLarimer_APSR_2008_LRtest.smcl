{com}. global lrchi2 = e(ll)
{txt}
{com}. global true_chi2=2*($lrchi2-$lrchi1)
{txt}
{com}. 
. display 2*($lrchi2-$lrchi1)
{res}58.307929
{txt}
{com}. 
. **** create null reference distribution of LR test statitics via a loop
. 
. gen Z_clust =.
{txt}(344,084 missing values generated)

{com}. gen junk=. 
{txt}(344,084 missing values generated)

{com}. gen junk1=.
{txt}(344,084 missing values generated)

{com}. gen junk2=.
{txt}(344,084 missing values generated)

{com}. gen junk3=.
{txt}(344,084 missing values generated)

{com}. gen junk4=.
{txt}(344,084 missing values generated)

{com}. 
. cap program drop lr_sim
{txt}
{com}. program define lr_sim, rclass
{txt}  1{com}.         cluster_ra Z_clust, cluster_var(hh_id) m_each(100000 20000 20000 20000 20002) replace
{txt}  2{com}.         replace junk = Z_clust
{txt}  3{com}.         qui xi: logistic voted i.junk
{txt}  4{com}.         replace junk1= _Ijunk_2
{txt}  5{com}.         replace junk2= _Ijunk_3
{txt}  6{com}.         replace junk3= _Ijunk_4
{txt}  7{com}.         replace junk4= _Ijunk_5
{txt}  8{com}.         qui logistic voted treat1 treat2 treat3 treat4 numvotes i.hh_size junk1 junk2 junk3 junk4
{txt}  9{com}.         local lr1 = e(ll)       
{txt} 10{com}.         qui xi: logistic voted treat1 treat2 treat3 treat4 junk1##c.numvotes junk2##c.numvotes junk3##c.numvotes        junk4##c.numvotes junk1##i.hh_size junk2##i.hh_size junk3##i.hh_size junk4##i.hh_size 
{txt} 11{com}.         local lr2 = e(ll)
{txt} 12{com}.         return scalar chi2=2*(`lr2'-`lr1')      
{txt} 13{com}. end
{txt}
{com}. 
. * Simulate the null reference distribution with an arbitrary degree of precision depending on "reps"
. preserve
{txt}
{com}. simulate chi2=r(chi2), reps(1000) seed(123) saving(ri_lr.dta, replace): lr_sim
{p2colset 7 17 21 2}{...}

{txt}{p2col :command:}lr_sim{p_end}
{p2colset 10 17 21 2}{...}
{p2col :chi2:}{res:r(chi2)}{p_end}
(note: file ri_lr.dta not found)

